PROJECT_NAME           = "Corelib owned-source documentation lint"
OUTPUT_DIRECTORY       = build/docs/lint
INPUT                  = src/Corelib.h src/corelib src/protocol/pfp.c src/protocol/transaction.c src/internal
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.ino
EXCLUDE_PATTERNS       = */vendor/* */generated/*
EXCLUDE_SYMBOLS        = CORELIB_GATEWAY_STORE
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
QUIET                  = YES
